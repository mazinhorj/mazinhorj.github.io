---
import '../styles/global.css';

// src/layouts/Layout.astro
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="pt-br">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Portfólio de Osmar Mazinho - Engenheiro de Software e Gestor Educacional" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>👨‍💻</text></svg>">		
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
	<footer class="max-w-4xl mx-auto px-6 py-8 border-t border-gray-100 dark:border-slate-800 flex flex-col md:flex-row justify-between items-center gap-4 text-center">
  		<p class="text-sm text-gray-500 dark:text-slate-400">
    		© 2026 Osmar (Mazinho) — Diretor & Engenheiro de Software
  		</p>
  	</footer>
</html>


